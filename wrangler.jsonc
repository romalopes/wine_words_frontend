{
  "name": "wine-words",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "previews": {
    "vars": {
      "VITE_API_BASE_URL": "https://api.wine-words.beachvolleyballhub.com/api/v1",
    },
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
