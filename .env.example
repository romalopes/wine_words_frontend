# API base URL for the Rails wine words API
# Set this to the URL of your wine_prediction_api Rails server.
# For local development the default is fine.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_NEON_AUTH_URL=
VITE_NEON_AUTH_URL_PRODUCTION=

# --- Social sign-in providers ----------------------------------------------
# Only PUBLIC identifiers belong here — they are compiled into the bundle.
# Never put a client secret, app secret or Apple private key in a VITE_ var.
#
# A provider whose client id is left blank is simply not offered by the UI.
# See wine_prediction_api/docs/social_authentication.md for the full setup.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Defaults to window.location.origin when unset.
VITE_APPLE_REDIRECT_URI=
VITE_MICROSOFT_CLIENT_ID=
# Must match the backend MICROSOFT_TENANT_ID (common | organizations | consumers | <tenant-id>).
VITE_MICROSOFT_TENANT_ID=common
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_GRAPH_VERSION=v21.0

# Sentry DSN
VITE_SENTRY_DSN=
